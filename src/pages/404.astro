---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { pickRandom } from "../utils/generic";

const suggestion = pickRandom(await getCollection("recipes"));
---

<Layout title="Not found">
  <main class="min-h-viewport bg-page p-4 flex items-center justify-center">
    <div class="w-full max-w-sm bg-surface rounded-xl shadow-sm p-6 text-center flex flex-col gap-4">
      <span class="text-4xl">🍳</span>
      <h1 class="text-xl font-bold text-ink">We don't have that one</h1>
      <p class="text-sm text-ink-muted">
        That recipe isn't in the collection &mdash; at least not under that name.
      </p>
      {
        suggestion && (
          <a
            href={`/recipe/${suggestion.id}`}
            class="min-h-[44px] flex items-center justify-center gap-2 bg-brand text-white font-semibold rounded-lg hover:bg-brand-strong"
          >
            <span>{suggestion.data.emoji}</span>
            <span>Try {suggestion.data.name}</span>
          </a>
        )
      }
      <a href="/" class="text-sm text-ink-subtle hover:text-ink">Back home</a>
    </div>
  </main>
</Layout>
