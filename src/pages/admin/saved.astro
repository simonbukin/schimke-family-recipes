---
import Layout from "../../layouts/Layout.astro";

const slug = Astro.url.searchParams.get("slug") ?? "";
const created = Astro.url.searchParams.get("created") === "true";

if (!slug) return Astro.redirect("/admin");
---

<Layout title="Saved">
  <main class="min-h-viewport bg-page p-4 flex items-center justify-center">
    <div class="w-full max-w-sm bg-surface rounded-xl shadow-sm p-6 text-center flex flex-col gap-4">
      <span class="text-4xl">✅</span>
      <h1 class="text-xl font-bold text-ink">
        {created ? "Recipe added" : "Changes saved"}
      </h1>
      <p class="text-sm text-ink-muted">
        Committed to the repo. The live site updates when the rebuild finishes &mdash;
        usually under a minute.
      </p>

      <a href={`/recipe/${slug}`} class="min-h-[44px] flex items-center justify-center bg-brand text-white font-semibold rounded-lg hover:bg-brand-strong">
        View the recipe
      </a>
      <a href="/admin" class="text-sm text-ink-subtle hover:text-ink">Back to all recipes</a>
    </div>
  </main>
</Layout>
